{
  "name": "homebridge-senec-battery",
  "version": "2.51.0",
  "description": "Homebridge Senec battery",
  "type": "module",
  "main": "dist/homebridge-senec-battery-platform.js",
  "scripts": {
    "clean": "rimraf ./dist",
    "prebuild": "npm link homebridge",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run build ",
    "postpublish": "npm run clean",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "npm run build && homebridge -I -D ",
    "link": "npm unlink senec-battery && npm link senec-battery",
    "unlink": "npm unlink senec-battery && npm install senec-battery@latest --save",
    "packupdate": "npm update --save",
    "preversion": "npm run build",
    "postversion": "git push && git push --tags"
  },
  "author": "Alexander Link",
  "maintainers": [
    "Alexander Link"
  ],
  "engines": {
    "homebridge": "^1.6.0 || ^2.0.0",
    "node": "^22 || ^24 || ^26"
  },
  "keywords": [
    "homebridge-plugin"
  ],
  "license": "MIT",
  "files": [
    "LICENSE",
    "dist",
    "src",
    "config.schema.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buddyshome/homebridge-senec-battery.git"
  },
  "bugs": {
    "url": "https://github.com/buddyshome/homebridge-senec-battery/issues"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "homebridge": {
      "optional": true
    }
  },
  "dependencies": {
    "senec-battery": "^1.22.0"
  }
}
