{
  // Node.js 22 / 24 / 26, ESM ("type": "module")
  // Based on the recommended @tsconfig/node22 settings
  "compilerOptions": {
    /* Language and environment */
    "target": "ES2022",
    "lib": ["ES2024"],
    "types": ["node"],

    /* Modules */
    "module": "NodeNext",
    "esModuleInterop": true,

    /* Emit */
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,

    /* Type checking */
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
